# ERA5 / CDS API (Copernicus Climate Data Store)
# Register at: https://cds.climate.copernicus.eu — paste key from your profile
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# TMD (Thai Meteorological Department)
TMD_API_TOKEN=
TMD_BASE_URL=https://data.tmd.go.th/nwpapi/v1

# TMD client (tmd_client.py)
TMD_API_KEY=your_tmd_api_key_here
TMD_BASE_URL=https://data.tmd.go.th/api/Weather/v1

# App
HEATSHIELD_ENV=dev
HEATSHIELD_LOG_LEVEL=INFO
